# Database connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=totp
DB_USER=totp
DB_PASSWORD=

### Encryption key (Base64 string, 32 bytes before encoding -> ~44 characters after base64)
### Master Fernet key. Losing it makes every stored TOTP secret unrecoverable — back it up outside the cluster.
### Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

### Secret key (random string, at least 32 bytes recommended, better 64+ bytes)
### Use for signing JWT tokens and other HMAC operations.
SECRET_KEY=

### URL of the frontend application. Used as a link in email templates
FRONTEND_URL=http://localhost:8000

### Allowed email domains for registration. Example: test1.com,test2.com or empty for any email domains
ALLOWED_EMAIL_DOMAINS=

### Default port is 8000 (compose only; the container always listens on 8000)
PORT=

# Access token lifetime in minutes (short-lived JWT used in the browser).
ACCESS_TOKEN_EXPIRE_MINUTES=5

# Refresh token lifetime in days (long-lived token to renew the access token).
REFRESH_TOKEN_EXPIRE_DAYS=30

# true  -> cookies are only sent over HTTPS (recommended for production).
# false -> cookies also work over HTTP (useful for local development).
COOKIE_SECURE=false

### Mailgun API credentials
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

### Number of Gunicorn workers. Prefer scaling pods over workers in Kubernetes.
# GUNICORN_WORKERS=1

### Set to 0 in the app container when a separate Job/initContainer runs migrations.
# RUN_MIGRATIONS=1

### Optional: comma-separated CORS origins (default "*").
# CORS_ORIGINS=https://totp.example.com

### Optional runtime recovery URL for the GeoIP database (normally baked into the image).
# GEOIP_URL=https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-City.mmdb
